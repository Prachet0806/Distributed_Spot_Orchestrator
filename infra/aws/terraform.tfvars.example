# Example Terraform variables file
# Copy this to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control (contains sensitive info)

# Required: AWS region for deployment
target_region = "us-east-1"

# Required: AMI ID (must match target_region)
# Find current Ubuntu 22.04 LTS AMIs at: https://cloud-images.ubuntu.com/locator/ec2/
ami_id = "ami-0c7217cdde317cfec"  # Update this for your region!

# Required: Your EC2 Key Pair name (create in AWS Console -> EC2 -> Key Pairs)
ssh_key_name = "my-aws-keypair"

# Required: Your public IP in CIDR notation
# Get your IP: curl https://checkip.amazonaws.com
# Format: YOUR_IP/32 (e.g., "1.2.3.4/32")
my_ip = "0.0.0.0/32"  # Replace with your actual IP!

# Optional: Override defaults
# instance_type = "c5.large"
# max_spot_price = "0.10"
# ssh_user = "ubuntu"

